{
  "name": "tmpup",
  "version": "2.0.0",
  "private": true,
  "description": "Temporary File Upload Service (TypeScript port)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-templates.mjs",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "fastify": "^5.6.1",
    "mime-types": "^3.0.2",
    "sharp": "^0.34.4",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
